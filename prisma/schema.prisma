// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String   @db.String(256)
  amount    Float
  date      DateTime
  category  String?
  description String?
  paid      Boolean  @default(false)
  weekPaid  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([paid])
}

model Payment {
  id        String   @id @default(cuid())
  payerId   String   @db.String(256)
  payeeId   String   @db.String(256)
  amount    Float
  txnRefs   String[] @default([])
  createdAt DateTime @default(now())

  @@index([payerId])
  @@index([payeeId])
}
